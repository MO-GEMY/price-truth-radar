{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asarak-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "asarak.com", "custom_domain": true },
    { "pattern": "www.asarak.com", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://asarak.com",
    "NEXT_PUBLIC_API_URL": "https://api.asarak.com",
    "NEXT_PUBLIC_ADSENSE_CLIENT": "ca-pub-6779998423158419",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-E736R78C95",
    "NEXT_PUBLIC_TIKTOK_PIXEL_ID": "DC49I9RC77U1013HFGH0",
    "NEXT_PUBLIC_AMAZON_EG_TAG": "asarak-21",
    "NEXT_PUBLIC_AFFILIATE_DEEPLINK_MAP": ""
  }
}
