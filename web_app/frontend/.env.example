# Canonical public site URL for Asarak (أسعارك)
NEXT_PUBLIC_SITE_URL=https://asarak.com

# FastAPI serving backend base URL (defaults to https://api.asarak.com in production)
# Leave EMPTY in local dev to run against the built-in contract-matching mock dataset.
NEXT_PUBLIC_API_URL=https://api.asarak.com

# Optional affiliate tracking parameters (leave empty for clean pass-through links)
NEXT_PUBLIC_AFFILIATE_AMAZON_TAG=
NEXT_PUBLIC_AFFILIATE_NOON_ID=
NEXT_PUBLIC_AFFILIATE_JUMIA_ID=
NEXT_PUBLIC_AFFILIATE_BTECH_ID=
