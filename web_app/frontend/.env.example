# Canonical public site URL for Asarak (أسعارك)
NEXT_PUBLIC_SITE_URL=https://asarak.com

# FastAPI serving backend base URL (defaults to https://api.asarak.com in production)
# Leave EMPTY in local dev to run against the built-in contract-matching mock dataset.
NEXT_PUBLIC_API_URL=https://api.asarak.com

# Optional affiliate tracking (leave empty for clean pass-through store links)
# Amazon Egypt Associates tag (e.g. asarak-21)
NEXT_PUBLIC_AMAZON_EG_TAG=
# Optional JSON map of store hostnames (without www.) or slugs to deeplink templates with {url}
# Example: {"noon.com":"https://network.example/click?url={url}","jumia.com.eg":"https://kol.example/?url={url}"}
NEXT_PUBLIC_AFFILIATE_DEEPLINK_MAP=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX) — leave empty to disable ads
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional per-placement AdSense ad unit slot IDs (leave empty to keep slot hidden)
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT=
NEXT_PUBLIC_ADSENSE_SLOT_DEALS=
NEXT_PUBLIC_ADSENSE_SLOT_COMPARE=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX) — leave empty to disable GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
